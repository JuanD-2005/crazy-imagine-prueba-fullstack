# Valores por defecto para correr el backend vía `docker compose up` en la raíz
# del repo: "postgres" y "n8n" son nombres de servicio en la red interna de
# Docker (no localhost). Si corres el backend fuera de Docker (`npm run
# start:dev` directo en el host), cambia esos hosts por "localhost" — ver la
# sección Setup del README.
DATABASE_URL="postgresql://crazysupporthub:crazysupporthub@postgres:5432/crazysupporthub?schema=public"
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN="1d"
N8N_WEBHOOK_URL="http://n8n:5678/webhook/ticket-enrichment"
N8N_WEBHOOK_SECRET="replace-with-a-long-random-secret"
PORT=3000
# Origen(es) permitidos por CORS para el frontend (separados por coma). El
# frontend siempre corre en el navegador del host, nunca dentro de Docker,
# así que esto es "localhost" incluso cuando el backend corre en el compose.
CORS_ORIGIN="http://localhost:5173"
