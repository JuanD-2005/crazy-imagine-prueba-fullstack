# @nestjs/throttler todavía no declara soporte oficial para @nestjs/common ^12
# en su peerDependencies (solo hasta ^11), aunque funciona correctamente contra
# la API de guards/interceptors de Nest 12 (mismo patrón que ya usamos con
# Prisma 7.10.0 pinneado por delante del ecosistema). Sin esto, `npm ci` falla
# con ERESOLVE tanto en local como en Docker/CI.
legacy-peer-deps=true
