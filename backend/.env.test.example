# Usado por `npm run test:e2e` (vía dotenv-cli) para correr los tests contra una
# base de datos separada de la de desarrollo — así una corrida interrumpida a
# mitad de camino nunca deja datos de test mezclados con los del seed real.
#
# La base "crazysupporthub_test" corre en el mismo Postgres del docker-compose,
# solo hay que crearla una vez:
#   docker compose exec postgres createdb -U crazysupporthub crazysupporthub_test
DATABASE_URL="postgresql://crazysupporthub:crazysupporthub@localhost:5432/crazysupporthub_test?schema=public"
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN="1d"
N8N_WEBHOOK_URL="http://localhost:5678/webhook/ticket-enrichment"
N8N_WEBHOOK_SECRET="replace-with-a-long-random-secret"
PORT=3000
CORS_ORIGIN="http://localhost:5173"
